{
  "apps": [
    {
      "name": "totalsegmentator",
      "konfai": [
        "totalsegmentator-konfai",
        "segment",
        "total",
        "-i",
        "{input}",
        "-o",
        "{output}",
        "--gpu",
        "0",
        "-q"
      ],
      "original": [
        "{venv}/bin/TotalSegmentator",
        "-i",
        "{input}",
        "-o",
        "{output}/total.nii.gz",
        "--ml",
        "-q"
      ],
      "cases": {
        "S": "~/.cache/konfai-bench/apps/in/ct_S.nii.gz",
